<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>

    <div class="card col-6 show-card listing-card">
      <img
        src="<%= listing.image.url %>"
        onerror="this.onerror=null; this.src='/images/default-listing.jpg';"
        class="card-img-top show-img"
        alt="listing_image"
      />
      <div class="card-body">
        <p class="card-text">Owned by: <i><%= listing.owner.username %></i></p>

        <p class="card-text"><%= listing.description %></p>
        <p class="card-text">₨ <%= listing.price.toLocaleString("en-PK") %> /night</p>
        <p class="card-text"><%= listing.location %></p>
        <p class="card-text"><%= listing.country %></p>
      </div>
    </div>

    <!-- Edit / Delete: only the listing owner sees these -->
    <% if (currUser && listing.owner._id.equals(currUser._id)) { %>
    <div class="btns col-6">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn">Edit</a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button type="submit" class="btn btn-dark delete-btn">Delete</button>
      </form>
    </div>
    <% } %>

    <!-- Review form: only logged-in users see this -->
    <% if (currUser) { %>
    <div class="mt-4">
      <hr>
      <h4>Leave a Review</h4>
      <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3">
          <label for="rating" class="form-label">Rating</label>
          <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
        </div>
        <div class="mb-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>
          <div class="invalid-feedback">
            Please add some comments for review
          </div>
        </div>
        <button class="btn btn-outline-dark mb-3">Submit</button>
      </form>
    </div>
    <% } %>

    <div class="mt-4">
      <hr>
      <h4>All Reviews</h4>

      <% if (listing.reviews.length === 0) { %>
        <p class="text-muted">No reviews yet. Be the first to leave one!</p>
      <% } %>

      <div class="row">
        <% for (let review of listing.reviews) { %>
          <div class="col-md-6 mb-3">
            <div class="card h-100 shadow-sm">
              <div class="card-body p-4">
                <h5 class="card-title">@<%= review.author ? review.author.username : "Anonymous" %></h5>
                <p class="card-text"><%= review.comment %></p>
                <p class="mb-2"><%= review.rating %> stars</p>

                <!-- Delete: only the review author sees this -->
                <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
                <% } %>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>

  </div>
</div>
