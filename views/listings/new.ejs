<% layout("/layouts/boilerplate") %>

<div class="row">
  <div class="col-8 offset-2">
    <h3>Create New Listing</h3>
    <form method="POST" action="/listings">
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          name="listing[title]"
          placeholder="Add a catchy title"
          type="text"
          class="form-control"
        />
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control"></textarea>
      </div>
      <div class="mb-3">
        <label for="image" class="form-label">Image URL/Link</label>
        <input
          name="listing[image][url]"
          placeholder="Add an image URL/Link"
          type="text"
          class="form-control"
        />
      </div>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label for="price" class="form-label">Price</label>
          <input
            name="listing[price]"
            placeholder="Add a price"
            type="number"
            class="form-control"
          />
        </div>
        <div class="col-md-8 mb-3">
          <label for="country" class="form-label">Country</label>
          <input
            name="listing[country]"
            placeholder="Add a country"
            type="text"
            class="form-control"
          />
        </div>
      </div>
      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input
          name="listing[location]"
          placeholder="Add a location"
          type="text"
          class="form-control"
        />
      </div>
      <button class="btn btn-dark add-btn">Add</button>
    </form>
  </div>
</div>